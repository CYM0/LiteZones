static const wchar_t *lz_text(const wchar_t *value) {
    if(!g_languageEnglish||!value)return value;
    for(unsigned int i=0;i<sizeof(g_translations)/sizeof(g_translations[0]);i++) {
        const wchar_t *a=value,*b=g_translations[i].zh;
        while(*a&&*b&&*a==*b){a++;b++;}
        if(!*a&&!*b)return g_translations[i].en;
    }
    return value;
}
static int lz_detectSystemLanguage(void) {
    /* Chinese Windows UI locales use Simplified Chinese; all others use English. */
    return (GetUserDefaultUILanguage()&0x03ffu)==0x0004u ? 0:1;
}
